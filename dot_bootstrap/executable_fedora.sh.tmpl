#!/usr/bin/env bash
# fedora-setup.sh - Fresh Fedora workstation bootstrap
set -euo pipefail

# ============================================================================
# Initialize Script
# ============================================================================

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
readonly SCRIPT_DIR

# Source configuration file
CONFIG_FILE="$SCRIPT_DIR/fedora.conf"
if [[ ! -f "$CONFIG_FILE" ]]; then
  echo -e "\033[1;31m[ERR ]\033[0m Configuration file not found: $CONFIG_FILE" >&2
  exit 1
fi
# shellcheck source=/dev/null
source "$CONFIG_FILE"

# Override config paths with script directory
readonly SSH_KEY="${SSH_KEY/bootstrap/${SCRIPT_DIR}}"
readonly DCONF_FILE="${DCONF_FILE/bootstrap/${SCRIPT_DIR}}"

# ============================================================================
# Helper Functions
# ============================================================================

log()  { echo -e "\033[1;32m[==> ]\033[0m $*"; }
warn() { echo -e "\033[1;33m[WARN]\033[0m $*" >&2; }
die()  { echo -e "\033[1;31m[ERR ]\033[0m $*" >&2; exit 1; }

cmd_exists() { command -v "$1" &> /dev/null; }

require_command() {
  if ! cmd_exists "$1"; then
    die "$1 is required but not found. Please install '$2' package."
  fi
}


# Task selection with whiptail
select_tasks() {
  local tasks=("GitHub SSH & Token Setup" "JetBrains Toolbox" "Flatpak Applications" "Snapper Configuration")
  
  require_command whiptail "newt"
  
  local checklist=()
  for task in "${tasks[@]}"; do
    checklist+=("$task" "" ON)
  done
  
  local selections
  if selections=$(whiptail --title "Bootstrap Tasks" --checklist \
    "Select which tasks to perform:" 20 50 4 "${checklist[@]}" 3>&1 1>&2 2>&3); then
    # Parse whiptail output (quoted values)
    eval "selected=($selections)"
    for task in "${tasks[@]}"; do
      for sel in "${selected[@]}"; do
        sel="${sel%\"}" sel="${sel#\"}"
        if [[ "$task" == "$sel" ]]; then
          # Task selected - set corresponding flag
          case "$task" in
            "GitHub SSH & Token Setup") ENABLE_GITHUB=1 ;;
            "JetBrains Toolbox") ENABLE_JETBRAINS=1 ;;
            "Flatpak Applications") ENABLE_FLATPAK=1 ;;
            "Snapper Configuration") ENABLE_SNAPPER=1 ;;
          esac
        fi
      done
    done
  else
    # User cancelled - run all by default
    ENABLE_GITHUB=1
    ENABLE_JETBRAINS=1
    ENABLE_FLATPAK=1
    ENABLE_SNAPPER=1
  fi
}

# Validate required inputs from chezmoi
validate_inputs() {
  if [[ -z "$GIT_NAME" || -z "$GIT_EMAIL" || -z "$GITHUB_USER" ]]; then
    die "Missing chezmoi data (git_name, git_email, github_user). Re-run: chezmoi apply"
  fi
  log "Using git identity from chezmoi: $GIT_NAME <$GIT_EMAIL>"
}

# Setup SSH directory
setup_ssh_dir() {
  mkdir -p "$HOME/.ssh"
  chmod 700 "$HOME/.ssh"
}

# ============================================================================
# Section: GitHub SSH & Token Setup
# ============================================================================

setup_github_ssh_key() {
  if [[ ! -f "$SSH_KEY" ]]; then
    local passphrase passphrase_verify
    while true; do
      read -rsp "Passphrase for SSH key (leave empty for none): " passphrase
      echo
      read -rsp "Verify passphrase: " passphrase_verify
      echo
      if [[ "$passphrase" == "$passphrase_verify" ]]; then
        break
      else
        warn "Passphrases do not match. Try again."
      fi
    done
    
    log "Generating ed25519 SSH key..."
    ssh-keygen -t ed25519 -C "$GIT_EMAIL" -f "$SSH_KEY" -N "$passphrase"
    unset passphrase passphrase_verify
  else
    log "SSH key already exists at $SSH_KEY - skipping generation."
  fi
}

validate_github_token() {
  local token="$1"
  local response
  
  log "Validating GitHub token..."
  if ! response=$(curl -fsSL -H "Authorization: Bearer $token" "$GITHUB_API_USER" 2>/dev/null); then
    die "Failed to validate GitHub token. Check your internet connection."
  fi
  
  if ! echo "$response" | jq -e '.login' > /dev/null 2>&1; then
    die "Invalid GitHub token or insufficient permissions."
  fi
  
  log "GitHub token validated successfully."
}

upload_github_ssh_key() {
  local token="$1"
  local pub_key
  local key_title
  local json_payload
  local http_status
  local response_file
  
  pub_key=$(cat "${SSH_KEY}.pub")
  key_title="$(hostname)-$(date +%Y%m%d)"
  response_file=$(mktemp)
  
  json_payload=$(jq -n \
    --arg title "$key_title" \
    --arg key "$pub_key" \
    '{title: $title, key: $key}')
  
  log "Uploading public key to GitHub (account: $GITHUB_USER)..."
  
  http_status=$(curl -fsSL \
    -o "$response_file" \
    -w "%{http_code}" \
    -X POST "$GITHUB_API_KEYS" \
    -H "Authorization: Bearer $token" \
    -H "Accept: application/vnd.github+json" \
    -H "X-GitHub-Api-Version: 2022-11-28" \
    -H "Content-Type: application/json" \
    -d "$json_payload") || true
  
  if [[ "$http_status" == "201" ]]; then
    log "SSH public key added to GitHub successfully (title: $key_title)."
  else
    warn "GitHub API returned HTTP $http_status - key may not have been added."
    warn "Response: $(cat "$response_file")"
    warn "Add the key manually at https://github.com/settings/keys"
    warn "Public key: $pub_key"
  fi
  
  rm -f "$response_file"
}

setup_github_integration() {
  if [[ ${ENABLE_GITHUB:-0} -eq 0 ]]; then
    log "Skipping GitHub SSH & Token Setup (as selected)."
    return
  fi
  
  setup_github_ssh_key
  
  echo "A GitHub Personal Access Token with write access to 'Git SSH Keys' is required."
  echo "Create one here: https://github.com/settings/personal-access-tokens"
  read -rsp "GitHub Personal Access Token: " GITHUB_TOKEN
  echo
  
  validate_github_token "$GITHUB_TOKEN"
  upload_github_ssh_key "$GITHUB_TOKEN"
  unset GITHUB_TOKEN  # Clear token from memory immediately
  
  log "Adding github.com to known_hosts..."
  ssh-keyscan -H github.com >> "$HOME/.ssh/known_hosts" 2>/dev/null
  
  log "Switching chezmoi git remote to SSH..."
  chezmoi git remote set-url origin "git@github.com:$GITHUB_USER/dotfiles.git"
}

# ============================================================================
# Section: System Configuration
# ============================================================================

setup_fonts() {
  log "Reloading Fedora font cache..."
  fc-cache
}

setup_gnome() {
  if [[ ! -f "$DCONF_FILE" ]]; then
    warn "dconf configuration file not found at $DCONF_FILE - skipping"
    return
  fi
  log "Applying Gnome configuration..."
  dconf load / < "$DCONF_FILE"
}

setup_grub() {
  if [[ ! -f "$GRUB_FILE" ]]; then
    warn "GRUB file not found at $GRUB_FILE - skipping AMD GPU configuration"
    return
  fi
  
  log "Updating GRUB configuration with AMD GPU settings..."
  sudo cp "$GRUB_FILE" "${GRUB_FILE}.backup"
  log "GRUB backup created at ${GRUB_FILE}.backup"
  
  if ! grep -q "amdgpu.abmlevel" "$GRUB_FILE"; then
    sudo sed -i 's/GRUB_CMDLINE_LINUX="/GRUB_CMDLINE_LINUX="amdgpu.abmlevel=0 /' "$GRUB_FILE"
    log "Added amdgpu.abmlevel=0 to GRUB_CMDLINE_LINUX"
    
    log "Rebuilding GRUB configuration..."
    sudo grub2-mkconfig -o /boot/grub2/grub.cfg
    log "GRUB configuration rebuilt successfully"
  else
    log "amdgpu.abmlevel already present in GRUB configuration"
  fi
}

# ============================================================================
# Section: Repository Setup
# ============================================================================

setup_vscode_repo() {
  log "Adding VS Code repository..."
  sudo rpm --import https://packages.microsoft.com/keys/microsoft.asc
  printf '[code]\nname=Visual Studio Code\nbaseurl=https://packages.microsoft.com/yumrepos/vscode\nenabled=1\nautorefresh=1\ntype=rpm-md\ngpgcheck=1\ngpgkey=https://packages.microsoft.com/keys/microsoft.asc\n' \
    | sudo tee /etc/yum.repos.d/vscode.repo > /dev/null
}

setup_copr_repos() {
  log "Enabling COPR repositories..."
  for repo in "${COPR_REPOS[@]}"; do
    log "  copr enable $repo"
    sudo dnf copr enable -y "$repo" 2>/dev/null || warn "Failed to enable COPR repo: $repo"
  done
}

# ============================================================================
# Section: Package Installation
# ============================================================================

install_packages() {
  log "Installing system packages (this may take a while)..."
  sudo dnf check-update -y || true  # ignore "No packages marked for update" exit code
  
  # Convert array to arguments for dnf install
  # shellcheck disable=SC2068
  sudo dnf install --allowerasing -y ${SYSTEM_PACKAGES[@]}
  
  # Post-install configuration
  log "Configuring mise..."
  mise use -g usage
  
  log "Changing default shell to zsh..."
  sudo chsh -s "$(which zsh)" "$USER"
}

# Install JetBrains Toolbox dependencies
install_jetbrains_deps() {
  log "Installing JetBrains Toolbox runtime dependencies..."
  # shellcheck disable=SC2068
  sudo dnf install -y ${JETBRAINS_DEPS[@]}
}

# ============================================================================
# Section: JetBrains Toolbox
# ============================================================================

setup_jetbrains() {
  if [[ ${ENABLE_JETBRAINS:-0} -eq 0 ]]; then
    log "Skipping JetBrains Toolbox installation (as selected)."
    return
  fi
  
  local toolbox_dir="$HOME/.local/share/jetbrains-toolbox"
  
  if [[ -d "$toolbox_dir" ]]; then
    log "Toolbox already exists at $toolbox_dir - skipping download."
    return
  fi
  
  log "Installing JetBrains Toolbox (latest)..."
  mkdir -p "$toolbox_dir"
  
  log "Downloading and extracting..."
  curl -fsSL "$GITHUB_TOOLBOX_DOWNLOAD" | tar -xz --strip-components=1 -C "$toolbox_dir"
  
  install_jetbrains_deps
  
  log "Launching Toolbox (will install itself to ~/.local/share/JetBrains/Toolbox)..."
  "$toolbox_dir/bin/jetbrains-toolbox" > /dev/null 2>&1 &
  disown
}

# ============================================================================
# Section: Snapper Configuration
# ============================================================================

setup_snapper() {
  if [[ ${ENABLE_SNAPPER:-0} -eq 0 ]]; then
    log "Skipping Snapper configuration (as selected)."
    return
  fi
  
  local snapper_config_file="$SCRIPT_DIR/snapper_root"
  
  if [[ ! -f "$snapper_config_file" ]]; then
    warn "Snapper configuration file not found at $snapper_config_file - skipping"
    return
  fi
  
  log "Configuring Snapper for root subvolume..."
  
  # Ensure snapper config directory exists
  sudo mkdir -p /etc/snapper/configs
  
  # Copy the snapper configuration to the appropriate location
  sudo cp "$snapper_config_file" /etc/snapper/configs/root
  sudo chmod 644 /etc/snapper/configs/root
  
  log "Snapper configuration installed at /etc/snapper/configs/root"
  
  # Enable and start Snapper timeline and cleanup systemd timers
  log "Enabling Snapper systemd units..."
  sudo systemctl enable snapper-timeline.timer snapper-cleanup.timer
  sudo systemctl start snapper-timeline.timer snapper-cleanup.timer
  
  log "Snapper timeline and cleanup timers started"
}

# ============================================================================
# Section: Flatpak Applications
# ============================================================================

setup_flatpak() {
  if [[ ${ENABLE_FLATPAK:-0} -eq 0 ]]; then
    log "Skipping Flatpak applications installation (as selected)."
    return
  fi
  
  log "Adding Flathub repository..."
  sudo flatpak remote-add --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo
  
  log "Installing Flatpak applications..."
  # shellcheck disable=SC2068
  flatpak install -y flathub ${FLATPAK_APPS[@]}
}

# ============================================================================
# Main Execution
# ============================================================================

main() {
  log "Starting Fedora workstation bootstrap..."
  
  validate_inputs
  setup_ssh_dir
  select_tasks
  
  log "Requesting sudo permissions..."
  sudo -v
  
  # System configuration
  setup_fonts
  setup_gnome
  setup_grub
  
  # Repository setup
  setup_vscode_repo
  setup_copr_repos
  
  # Package installation
  install_packages
  
  # Optional components
  setup_jetbrains
  setup_flatpak
  setup_snapper
  setup_github_integration
  
  log "Setup complete! Reboot is recommended to ensure all changes take effect."
}

main "$@"
